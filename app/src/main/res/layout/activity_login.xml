<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0D10"
    android:orientation="vertical">

    <TextView
        android:id="@+id/login_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#14171C"
        android:paddingLeft="24dp"
        android:paddingTop="8dp"
        android:paddingRight="24dp"
        android:paddingBottom="8dp"
        android:text="Arrows move between fields. OK opens the keyboard or presses a button. Back leaves."
        android:textColor="#A9B2BE"
        android:textSize="14sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/login_web"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:focusable="true"
            android:focusableInTouchMode="true" />

        <LinearLayout
            android:id="@+id/login_loading"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#0B0D10"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="48dp">

            <ProgressBar
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminate="true" />

            <TextView
                android:id="@+id/login_loading_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Opening X sign-in…"
                android:textColor="#F5F7FA"
                android:textSize="22sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/login_error"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#0B0D10"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="48dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/login_error_code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#4DA3FF"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/login_error_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="#F5F7FA"
                android:textSize="20sp" />

            <Button
                android:id="@+id/login_retry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Retry"
                android:textSize="18sp" />

            <Button
                android:id="@+id/login_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Back"
                android:textSize="18sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
